# Mẫu cấu hình môi trường cho EduShare Backend
PORT=5500
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password

# Cấu hình drive.vn-ai.cloud API (HCDrive)
VNAI_DRIVE_BASE_URL=https://drive.vn-ai.cloud/api
VNAI_DRIVE_API_NAME=api_edu_share
VNAI_DRIVE_API_KEY=your_api_key_here
VNAI_DRIVE_FOLDER=edushare
VNAI_DRIVE_FOLDER_ID=
FILE_RETENTION_DAYS=60

# Cấu hình Phân hệ Hình Học (GeoChalk)
GEOCHALK_URL=https://math.vn-ai.cloud/geochalk/geochalk.html

